+<?php
+
+namespace App\Services;
+
+use Illuminate\Support\Facades\Http;
+
+/**
+ * AiResponder permite generar respuestas más humanas a través del modelo de lenguaje de OpenAI.
+ * Este servicio se basa en la API de OpenAI (ChatGPT) y requiere configurar la variable
+ * OPENAI_API_KEY en el archivo .env.
+ */
+class AiResponder
+{
+    protected string $apiKey;
+
+    public function __construct()
+    {
+        $this->apiKey = config('services.openai.api_key');
+    }
+
+    /**
+     * Envía el mensaje del usuario al modelo de lenguaje y devuelve una respuesta.
+     * Para mantener el control del flujo, se puede ajustar el prompt para que el modelo
+     * responda de forma cordial y luego solicite la información necesaria.
+     */
+    public function respond(string $userMessage): ?string
+    {
+        if (!$this->apiKey) {
+            // Si no hay API key configurada, no se intenta llamar al modelo.
+            return null;
+        }
+
+        $endpoint = 'https://api.openai.com/v1/chat/completions';
+        $payload = [
+            'model' => 'gpt-3.5-turbo',
+            'messages' => [
+                [
+                    'role' => 'system',
+                    'content' => 'Eres un amable asistente de un salón de eventos que ayuda a resolver dudas y recopilar datos de clientes. Responde de manera breve, cordial y profesional.',
+                ],
+                [
+                    'role' => 'user',
+                    'content' => $userMessage,
+                ],
+            ],
+            'max_tokens' => 200,
+            'temperature' => 0.6,
+        ];
+
+        try {
+            $response = Http::withToken($this->apiKey)
+                ->timeout(10)
+                ->post($endpoint, $payload)
+                ->throw()
+                ->json();
+
+            return data_get($response, 'choices.0.message.content');
+        } catch (\Throwable $e) {
+            // Log de error y fallback a null para no interrumpir el flujo principal.
+            \Log::error('AI response error: ' . $e->getMessage());
+            return null;
+        }
+    }
+}
+
